rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only write their own profile
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;

      // Saved opportunities: subcollection under the owner's own doc, doc id
      // is just the opportunityId. Simpler than a top-level collection would
      // be — ownership is entirely path-based (uid is already the {uid}
      // segment above), so there's no resource.data field to check and no
      // "document might not exist yet" edge case like the old top-level
      // collection had (see git history / prior version of this file for
      // that bug — checking resource.data.uid when resource is null used to
      // throw and fail closed on every "not saved yet" check).
      match /savedOpportunities/{opportunityId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Onboarding survey answers (interests, gender) — never merged into
      // the main users/{uid} doc above, because that doc's read rule is
      // "any signed-in user" (needed so getUserInfo() can show poster/author
      // display names elsewhere). Firestore rules can't restrict individual
      // fields within one document, only whole documents — so keeping these
      // answers private required splitting them into their own path with
      // its own, stricter, owner-only rule.
      match /private/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Projects: public readable, only owner/members write
    match /projects/{projectId} {
      allow read: if resource.data.visibility == 'public'
                  || request.auth.uid == resource.data.ownerUid
                  || request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      // The owner can update anything (including memberUids when accepting
      // a join request). A non-owner can also update — but only if the sole
      // effect is following/unfollowing (Follow project) or joining via an
      // accepted request being applied — i.e. affectedKeys is limited to the
      // follow fields. This mirrors clubs' self-join carve-out below.
      allow update: if request.auth.uid == resource.data.ownerUid
                    || request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['followerCount', 'followerUids']);
      allow delete: if request.auth.uid == resource.data.ownerUid;

      match /journalEntries/{entryId} {
        allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.visibility == 'public'
                    || request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
        allow create: if request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
        // The author can edit/delete their own entry outright. Anyone who
        // can read this project's journal (public, or a member of a
        // private one) can also update — but only cheer/comment-count
        // fields, same affectedKeys().hasOnly(...) carve-out as clubs'
        // discussions, so a reader can't rewrite someone else's post text
        // through the same path.
        allow update: if request.auth.uid == resource.data.authorUid
                      || ((get(/databases/$(database)/documents/projects/$(projectId)).data.visibility == 'public'
                           || request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids)
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['cheerCount', 'cheeredByUids', 'commentCount']));
        allow delete: if request.auth.uid == resource.data.authorUid;

        match /comments/{commentId} {
          allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.visibility == 'public'
                      || request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
          allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
          allow update, delete: if request.auth.uid == resource.data.authorUid;
        }
      }

      // Ask-to-join requests. Doc id is the requester's own uid, so create
      // is a simple identity check and there's at most one request per
      // person per project. Accept/Decline delete the doc rather than
      // marking it resolved — see lib/useJoinProjectRequest.ts for why —
      // so there's no update rule at all: a request is either pending
      // (the doc exists) or resolved (it's gone).
      match /joinRequests/{requesterUid} {
        allow read: if request.auth.uid == requesterUid
                    || request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid;
        allow create: if request.auth.uid == requesterUid
                      && request.resource.data.uid == requesterUid
                      && request.resource.data.status == 'pending';
        allow delete: if request.auth.uid == requesterUid
                      || request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid;
      }
    }

    // Clubs: readable by anyone signed in, posting requires membership
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.adminUids.hasAny([request.auth.uid]);
      // Admins can update anything. A non-admin can only update if the sole
      // effect is adding themselves to memberUids (self-join, from the
      // "Join" button) — they weren't a member before, they are after.
      allow update: if request.auth.uid in resource.data.adminUids
                    || (!(request.auth.uid in resource.data.memberUids)
                        && request.auth.uid in request.resource.data.memberUids);
      allow delete: if request.auth.uid in resource.data.adminUids;

      match /discussions/{discussionId} {
        allow read: if request.auth != null;
        allow create: if request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
        // The author can edit/delete their own post outright (including
        // stopping/removing a recurring event, or deleting it entirely).
        // Any other club member can also update — but only if the change is
        // limited to the cheer/RSVP fields (Cheer, Going, Interested).
        // affectedKeys().hasOnly(...) keeps a member from being able to
        // rewrite someone else's title/content through the same path.
        allow update: if request.auth.uid == resource.data.authorUid
                      || (request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['cheerCount', 'cheeredByUids', 'goingCount', 'interestedCount', 'goingUids', 'interestedUids']));
        allow delete: if request.auth.uid == resource.data.authorUid;
      }
    }

    // Opportunities: not in CLAUDE.md's example ruleset, added here to match
    // how the app actually uses this collection. Readable by any signed-in
    // user; only educators/admins can post one, matching the product rule
    // that adults post opportunities rather than to the student project feed.
    match /opportunities/{opportunityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.posterUid == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['educator', 'admin'];
      allow update, delete: if request.auth.uid == resource.data.posterUid;
    }

    // Reports: write-only from the client. CLAUDE.md's safety rule #5
    // requires every user-generated surface to have a report button that
    // writes here — ReportButton.tsx is the first one built. No client read
    // access at all: reviewing reports is a moderator/backend concern, not
    // something any signed-in user should be able to browse.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // follows/ and notifications/ aren't covered yet — nothing in the app
    // writes to them so far. Add rules here when those features get built;
    // until then they're implicitly deny-all, which is correct.
  }
}
