# Copy this file to .env.local and fill in values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
# .env.local is gitignored and must never be committed.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Cloud Console > APIs & Services > Credentials. Separate project/key
# from Firebase — restrict it to the Places API only, and to your domain's
# HTTP referrers. See the assistant's explanation for the exact steps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Image uploads (journal entries, comments, discussions) go to Cloudinary's
# free tier instead of Firebase Storage — Storage now requires the paid
# Blaze plan even at zero usage, which Cloudinary's unsigned-upload flow
# avoids entirely. Neither value below is a secret (that's the point of an
# "unsigned" preset — no API key/secret ever touches the client):
#   1. Sign up free at cloudinary.com — no credit card required.
#   2. Your "Cloud name" is shown on the dashboard home page.
#   3. Settings > Upload > Upload presets > Add upload preset. Set
#      "Signing Mode" to Unsigned, save, and copy its name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
